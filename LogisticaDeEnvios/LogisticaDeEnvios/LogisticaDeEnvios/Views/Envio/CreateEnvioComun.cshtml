@model LogisticaDeEnvios.Models.AltaEnvioComunViewModel

<h1>Create Envio Comun</h1>

<form asp-action="CreateEnvioComun">
    <div class="form-group">
        <label asp-for="Dto.ClienteEmail" class="control-label"></label>
        <input asp-for="Dto.ClienteEmail" class="form-control" />
        <span asp-validation-for="Dto.ClienteEmail" class="text-danger"></span>
    </div>



    <div class="form-group">
        <label asp-for="Dto.AgenciaId" class="control-label"></label>
        <select asp-for="Dto.AgenciaId" asp-items="Model.Agencia" class="form-control">
            <option value="-1">Seleccione Agencia</option>
        </select>
    </div>

    <div class="form-group">
        <label asp-for="Dto.Peso" class="control-label"></label>
        <input asp-for="Dto.Peso" class="form-control" />
        <span asp-validation-for="Dto.Peso" class="text-danger"></span>
    </div>

    <div class="form-group">
        <input type="submit" value="Create" class="btn btn-primary" />
    </div>
</form>
@TempData["Mensaje"]
