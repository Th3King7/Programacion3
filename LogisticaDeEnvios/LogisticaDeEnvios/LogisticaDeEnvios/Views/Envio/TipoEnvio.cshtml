@model LIbreria.DTOs.DTOs.DTOsEnvio.DTOAltaEnvio

@{
    ViewData["Title"] = "TipoEnvio";
}

<h1>TipoEnvio</h1>

<h4>DTOAltaEnvio</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="TipoEnvio">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label for="tipo">Seleccione un tipo de envío:</label>
                <select class="form-select"  name="tipo">
                    <option value="-1">Seleccione</option>
                    <option value="comun">Envio comun</option> 
                    <option value="urgente">Envio Urgente </option>
                </select>
            </div>
           
            <div class="form-group">
                <input type="submit" value="seleccionar" class="btn btn-primary" />
            </div>
        </form>
        @TempData["Mensaje"]
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
