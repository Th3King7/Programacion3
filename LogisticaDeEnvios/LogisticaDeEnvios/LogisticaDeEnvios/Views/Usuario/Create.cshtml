@model LogisticaDeEnvios.Models.AltaUsuarioViewModel


<h1>Create</h1>

<h4>Crear Funcionario</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="DtoAlta.Nombre" class="control-label"></label>
                <input asp-for="DtoAlta.Nombre" class="form-control" />
                <span asp-validation-for="DtoAlta.Nombre" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="DtoAlta.Apellido" class="control-label"></label>
                <input asp-for="DtoAlta.Apellido" class="form-control" />
                <span asp-validation-for="DtoAlta.Apellido" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="DtoAlta.Email" class="control-label"></label>
                <input asp-for="DtoAlta.Email" class="form-control" />
                <span asp-validation-for="DtoAlta.Email" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="DtoAlta.Password" class="control-label"></label>
                <input asp-for="DtoAlta.Password" class="form-control" />
                <span asp-validation-for="DtoAlta.Password" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="DtoAlta.Rol" class="control-label"></label>
                <select asp-for="DtoAlta.Rol">
                    <option value="-1">Seleccionar Rol</option>
                    <option value="0">Administrador</option>
                    <option value="1">Funcionario</option>
                    <option value="2">Cliente</option>
                </select>
            </div>
            <div class="form-group">
                <label asp-for="DtoAlta.AgenciaId" class="control-label"></label>
                <select asp-for="DtoAlta.AgenciaId" asp-items="Model.Agencia" class="form-control">
                    <option value="-1">Seleccione Agencia</option>
                </select>
            </div>
         
            <div class="form-group">
                <input type="submit" value="Create" class="btn btn-primary" />
            </div>
        </form>
        @TempData["Mensaje"]
    </div>
</div>

<div>
    <a asp-action="Index">Inicio</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
@TempData["Mensaje"]